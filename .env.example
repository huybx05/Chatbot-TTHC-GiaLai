# MẪU cấu hình — sao chép thành .env rồi điền giá trị thật.
# Khoá bí mật (API key, mật khẩu) để TRỐNG ở đây; điền trong .env.

APP_ENV=
DEBUG=
FORCE_HTTPS=
LOG_LEVEL=
API_V1_PREFIX=
ALLOWED_HOSTS=
CORS_ORIGINS=
REDIS_URL=
TRUSTED_PROXY_IPS=
LOGIN_RATE_LIMIT_PER_MIN=
REGISTER_RATE_LIMIT_PER_MIN=
REFRESH_RATE_LIMIT_PER_MIN=
CHAT_RATE_LIMIT_PER_MIN=
ADMIN_LLM_RATE_LIMIT_PER_MIN=
SECRET_KEY=
DATA_ROOT=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_ATTEMPTS=
LOCKOUT_MINUTES=
MEMORY_ENABLED=true
MEMORY_RECENT_MESSAGES=6
MEMORY_SUMMARY_TRIGGER_PAIRS=10
MEMORY_SUMMARY_KEEP_PAIRS=2
MEMORY_MAX_CHARS=7000
MEMORY_MESSAGE_MAX_CHARS=1200
MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_REWRITE_ENABLED=true
MEMORY_REWRITE_CONFIDENCE_MIN=0.70
MEMORY_REWRITE_MAX_CHARS=600
MEMORY_REWRITE_TIMEOUT_S=5
MEMORY_REWRITE_MAX_ATTEMPTS=2
MEMORY_REWRITE_RETRY_DELAY_S=2.5
MEMORY_SUMMARY_TIMEOUT_S=20
MEMORY_SUMMARY_RETRY_DELAY_S=2.5
QWEN_BASE_URL=
QWEN_API_KEY=
ROUTER_MODEL_NAME=
EMBEDDING_MODEL_NAME=
RERANKER_MODEL_NAME=
EMBEDDING_DIM=
EMBEDDING_BATCH_SIZE=
EMBEDDING_MAX_LENGTH=
RERANKER_BASE_URL=
RERANKER_TOP_N=
RERANKER_FINAL_K=
# Ngưỡng CỔNG VÀO: chấm 1 tài liệu tốt nhất; dưới ngưỡng này thì không trả lời.
# Đo trên 31 câu ngắn: trong phạm vi 0,63-0,95 · ngoài phạm vi 0,45-0,54.
RERANKER_GATE_MIN_SCORE=0.60
# Ngưỡng LỌC TỪNG CHUNK trong danh sách rerank. Để 0.0 = không lọc.
# KHÔNG truyền 0.60 vào đây: chunk đúng điểm thấp sẽ bị loại âm thầm.
CHUNK_FILTER_MIN_SCORE=0.0
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
SYNTHESIZER_MODEL_NAME=
SYNTHESIZER_TEMPERATURE=
SYNTHESIZER_MAX_TOKENS=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_DB=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=
# Dùng cho docker-compose.prod.yml (user admin tạo DB/role).
POSTGRES_ADMIN_PASSWORD=
REDIS_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
NEO4J_URL=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
# run_id của bộ dữ liệu trong đồ thị: 'test' (49 thủ tục) hoặc tên run bộ đầy đủ.
# Mọi Cypher đều lọc theo giá trị này để không trộn hai bộ.
NEO4J_RUN_ID=
NEO4J_TIMEOUT=
ELASTICSEARCH_HOST=
ELASTICSEARCH_INDEX=
ELASTIC_USER=
ELASTIC_PASSWORD=
ELASTIC_REQUEST_TIMEOUT=
QDRANT_HOST=
QDRANT_COLLECTION_SEMANTIC=
QDRANT_COLLECTION_FAQ=
QDRANT_API_KEY=
RRF_K_CONSTANT=
HYBRID_BRANCH_K=
RRF_KEYWORD_WEIGHT=
RRF_VECTOR_WEIGHT=
MAX_RETRY_COUNT=
